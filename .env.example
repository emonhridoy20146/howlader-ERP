APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Dizicashier import (php artisan dizicash:sync)
DIZICASHIER_BASE_URL=https://api.dizicashier.com
DIZICASHIER_USERNAME=
DIZICASHIER_PASSWORD=
DIZICASHIER_IMPORT_USER_ID=1
# DIZICASHIER_TOKEN_STORAGE_PATH=/absolute/path/to/dizicashier-token.json
# DIZICASHIER_POSTMAN_COLLECTION="${PWD}/Dizicash.postman_collection.json"
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SMS (BulkSMSBD) — SMS is only sent manually from the SMS page ---
SMS_ENABLED=true
SMS_ALLOWED_ROLES=admin,super-admin,super_admin,system
SMS_DEFAULT_SENDER_TYPE=non_masking
SMS_MAX_BULK_RECIPIENTS=5000
BULKSMSBD_BASE_URL=http://bulksmsbd.net/api
BULKSMSBD_API_KEY=
# Approved brand name, e.g. HOWLADER (masking)
BULKSMSBD_SENDER_ID_MASKING=
# Numeric sender from your BulkSMSBD panel (non-masking)
BULKSMSBD_SENDER_ID_NON_MASKING=
# Your per-SMS price in BDT, used to estimate remaining SMS
BULKSMSBD_RATE_MASKING=0
BULKSMSBD_RATE_NON_MASKING=0

# --- Field Operations API (/api/field/v1, docs/field-api/README.md) ---
# Off by default: every route answers 404 until this is true.
FIELD_API_ENABLED=false
# Values come from `php artisan field-api:setup` (the token itself is never stored here, only its SHA-256).
FIELD_API_USER_ID=
FIELD_API_TOKEN_SHA256=
FIELD_API_TOKEN_NEXT_SHA256=
# Empty = a collection of any past date is accepted (OD-28). A number limits it to that many days back.
FIELD_API_MAX_BACKDATE_DAYS=
FIELD_API_RATE_PER_MINUTE=300
